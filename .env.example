# Supabase — client (browser) config. These are PUBLIC values, safe to ship in
# the client bundle. Vite inlines any VITE_-prefixed var at build time.
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
# Anon/publishable key. Either the legacy anon JWT or the new-format
# publishable key (sb_publishable_...) works; the client handles both.
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY"

# Supabase — SERVER-SIDE ONLY. Read via process.env inside the SSR/server
# functions (src/integrations/supabase/client.server.ts). These must be set in
# the SERVER environment (Cloudflare), NOT prefixed with VITE_, and NEVER shipped
# to the browser. The service-role key bypasses RLS — keep it secret.
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
